# Claude turns spoken commands into board actions. Simple commands (undo, redo, yes, no, cancel) work without it.
ANTHROPIC_API_KEY=

# Local standby when Claude is unavailable. Install the model with `ollama pull qwen3:8b`.
# An empty value disables standby. Natter never downloads models itself.
NATTER_OLLAMA_MODEL=qwen3:8b
