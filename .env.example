# Which LLM words ideas and turns spoken commands into board actions.
# Leave empty for a hosted model: your Claude Code login, or ANTHROPIC_API_KEY below if set.
# Set to local to use only the Ollama model below, with nothing sent off this Mac.
# Simple commands (undo, redo, yes, no, cancel) work without any LLM.
NATTER_LLM=

ANTHROPIC_API_KEY=

# The local model. Install it with `ollama pull qwen3:8b`. With a hosted model it stands in
# while that one is slow or down; an empty value turns that off. Natter never downloads models itself.
NATTER_OLLAMA_MODEL=qwen3:8b
